# Generate actual local credentials with: python tools/setup_env.py
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
APP_DB_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
WORKER_DB_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
AUTH_SECRET=GENERATE_WITH_SETUP_SCRIPT
METRICS_TOKEN=GENERATE_WITH_SETUP_SCRIPT
CHAT_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text
MODEL_TIMEOUT_SECONDS=300
MODEL_CONTEXT_SIZE=4096
MODEL_MAX_TOKENS=1024
MODEL_CONCURRENCY=1
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_REGISTRATION=true
APP_ORIGIN=http://localhost:3000
KEYCLOAK_ADMIN_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
# Optional local Keycloak: docker compose --profile sso up -d keycloak
# OIDC_ISSUER=http://localhost:8081/realms/rag
# OIDC_INTERNAL_ISSUER=http://keycloak:8080/realms/rag
# OIDC_CLIENT_ID=rag-web
OCR_ENABLED=true
OCR_MAX_PAGES=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
