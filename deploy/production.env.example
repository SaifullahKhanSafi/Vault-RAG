# Copy this template only for a NEW installation. Run tools/setup_env.py --production.
# Never put real credentials in this tracked file.
PUBLIC_ORIGIN=https://rag.example.com
POSTGRES_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
APP_DB_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
WORKER_DB_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
AUTH_SECRET=GENERATE_WITH_SETUP_SCRIPT
METRICS_TOKEN=GENERATE_WITH_SETUP_SCRIPT
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text
MODEL_CONTEXT_SIZE=4096
MODEL_MAX_TOKENS=1024
MODEL_TIMEOUT_SECONDS=300
MODEL_CONCURRENCY=1
ALLOW_REGISTRATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
OIDC_ISSUER=
OIDC_CLIENT_ID=rag-web
OIDC_CLIENT_SECRET=
